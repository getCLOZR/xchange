# Application
APP_NAME=CLOZR Exchange API
ENVIRONMENT=development

# Database (required)
# macOS Homebrew example:
DATABASE_URL=postgresql://sarabaftab@localhost:5432/clozr_exchange
# Docker Compose example:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/clozr_exchange

# API server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Orchestration
WORKER_HTTP_TIMEOUT_SECONDS=30

# Dashboard CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
